// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["typedSql"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Game {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  free       Boolean @default(false)
  guildId    String  @map("guild_id")
  name       String
  maxPlayers Int     @map("max_players")
  minPlayers Int     @default(1) @map("min_players")
  released   Boolean @default(true)

  gameURL String? @map("game_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  createdById String @map("created_by_id") @db.Uuid
  createdBy   User   @relation(fields: [createdById], references: [id])

  gameResourceId String?       @map("game_resource_id") @db.Uuid
  gameResource   GameResource? @relation(fields: [gameResourceId], references: [id])

  ratings Rating[]

  @@map("games")
}

enum GamePlatform {
  STEAM

  @@map("game_platform")
}

model GameResource {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  externalId String       @map("external_id")
  free       Boolean      @default(false)
  platform   GamePlatform
  released   Boolean      @default(true)

  bannerImageURL    String? @map("banner_image_url")
  description       String?
  thumbnailImageURL String? @map("thumbnail_image_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  game Game[]

  @@unique([externalId, platform], name: "externalIdPlatform")
  @@map("game_resources")
}

model Rating {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  score Int

  gameId String @map("game_id") @db.Uuid
  game   Game   @relation(fields: [gameId], onDelete: Cascade, references: [id])

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  @@unique([gameId, userId])
  @@map("ratings")
}

model User {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  discordId String @unique @map("discord_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  games   Game[]
  ratings Rating[]

  @@map("users")
}
