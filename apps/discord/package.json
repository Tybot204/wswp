{
  "license": "UNLICENSED",
  "name": "discord",
  "dependencies": {
    "database": "workspace:*",
    "discord.js": "^14.18.0",
    "steamapi": "^3.1.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "globals": "^16.5.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.12",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "tsc --noemit && esbuild ./src/index.ts --bundle --outdir=./build --external:discord.js --external:steamapi --platform=node --sourcemap",
    "start": "node ./build/index.js",
    "start:dev": "NODE_ENV=development tsx watch --include \"./node_modules/database/*\" -r dotenv/config ./src/index.ts"
  }
}
